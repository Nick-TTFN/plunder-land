{
    "jsc": {
        "externalHelpers": false,
        "target": "es2022",
        "parser": {
            "syntax": "typescript",
            "tsx": true,
            "decorators": true
        },
        "transform": {
            "useDefineForClassFields": true
        }
    },
    "module": {
        "type": "commonjs"
    }
}
